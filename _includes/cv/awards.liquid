{% comment %}
  Local override of al_folio_cv's cv/awards.liquid.
  No date badge column: `title` is Markdown (so the data can bold the award name
  and link part of it, as in the CV PDF), the year renders inline after it
  ("Name, year"), and an optional `summary` renders as an italic line beneath.
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      <p class="ml-1 ml-md-4 mb-0">
        {{ entry.title | markdownify | remove: '<p>' | remove: '</p>' | strip -}}
        {%- if entry.date %}, {{ entry.date }}{% endif %}
        {% if entry.summary %}
          <br>
          <em>{{ entry.summary }}</em>
        {% endif %}
      </p>
    </li>
  {% endfor %}
</ul>
