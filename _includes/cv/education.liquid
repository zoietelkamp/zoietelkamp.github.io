{% comment %}
  Local override of al_folio_cv's cv/education.liquid.
  No date badge column: each entry renders its `degrees` (one bold line each,
  dates inline), then the institution, an italic `advisor` line, and an optional
  plain `details` line, matching the layout of cv/experience.liquid.
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      <div class="col-xs-12 col-sm-12 col-md-12">
        {% for degree in entry.degrees %}
          <h6 class="title font-weight-bold ml-1 ml-md-4">{{ degree }}</h6>
        {% endfor %}

        {% if entry.institution %}
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ entry.institution }}</h6>
        {% endif %}

        {% if entry.advisor %}
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ entry.advisor }}</h6>
        {% endif %}

        {% if entry.details %}
          <p class="ml-1 ml-md-4 mb-0">{{ entry.details | markdownify | remove: '<p>' | remove: '</p>' }}</p>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
